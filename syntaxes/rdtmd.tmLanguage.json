      "begin": "^\\s{0,3}(\\$\\$)\\s*$",
      "end": "^\\s{0,3}(\\$\\$)\\s*$",
      "name": "markup.math.block.rdtmd",
      "beginCaptures": { "1": { "name": "punctuation.definition.math.rdtmd" } },
      "endCaptures": { "1": { "name": "punctuation.definition.math.rdtmd" } }
    },
    "chart": {
      "begin": "^(:::)(chart)\\b(.*)$",
      "end": "^(:::)\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.directive.rdtmd" },
        "2": { "name": "keyword.control.directive.rdtmd" },
        "3": { "name": "string.quoted.rdtmd" }
      },
      "endCaptures": { "1": { "name": "punctuation.definition.directive.rdtmd" } },
      "patterns": [
        { "match": "^\\s*//.*$", "name": "comment.line.rdtmd" },
        {
          "match": "^\\s*(@\\w+)\\s*(.*)$",
          "captures": {
            "1": { "name": "keyword.other.option.rdtmd" },
            "2": { "name": "string.unquoted.rdtmd" }
          }
        },
        {
          "match": "^\\s*([^:\\n]+?)\\s*(:)\\s*(.*)$",
          "captures": {
            "1": { "name": "entity.name.tag.rdtmd" },
            "2": { "name": "punctuation.separator.key-value.rdtmd" },
            "3": { "patterns": [{ "match": "-?\\d+(?:\\.\\d+)?", "name": "constant.numeric.rdtmd" }] }
          }
        }
      ]
    },
    "diagram": {
