      "beginCaptures": {
        "1": { "name": "punctuation.definition.markdown.rdtmd" },
        "2": { "name": "fenced_code.block.language.rdtmd" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.markdown.rdtmd" } },
      "patterns": [{ "include": "source.python" }]
