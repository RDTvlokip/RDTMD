{
  "brackets": [["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "`", "close": "`", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["[", "]"], ["(", ")"], ["`", "`"], ["*", "*"], ["_", "_"], ["~", "~"], ["$", "$"], ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^:{3,}\\s*[A-Za-z]",
      "end": "^:{3,}\\s*$"
    }
  }
}
